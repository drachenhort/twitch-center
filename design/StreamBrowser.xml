<?xml version="1.0" encoding="UTF-8"?>
<!--
  StreamBrowser.xml — twitch-center custom window, Material 3 styling.

  Kodi has no CSS, no corner-radius property, and no real box-shadow.
  "Material" here means: Material's color tokens, Material's type scale
  (Roboto), and elevation faked by swapping in a pre-rendered card
  texture (rounded corners + soft shadow baked into the PNG) on focus.

  Required texture assets (drop in resources/skins/Default/media/):
    card_surface.png       - flat card, surface container color, rounded
                              12dp corners, NO shadow (resting state)
    card_surface_focus.png - same card, +2 shadow "elevation" baked in,
                              slightly lighter fill (surface container high)
    badge_live.png         - small rounded-pill shape, live-badge color
    thumb_mask.png          - rounded-corner mask/frame overlay for thumbnails

  These are 9-patch-style stretchable PNGs (Kodi honors border insets via
  the texture's own transparent padding + <texturefocus border="l,t,r,b">),
  so one small PNG scales cleanly to any card width.
-->
<window>
    <defaultcontrol always="true">3000</defaultcontrol>
    <onload condition="true">SetProperty(loaded,true)</onload>

    <controls>

        <!-- Base surface fill -->
        <control type="image">
            <posx>0</posx>
            <posy>0</posy>
            <width>1920</width>
            <height>1080</height>
            <colordiffuse>$VAR[Color_Surface]</colordiffuse>
            <texture>colors/white.png</texture>
        </control>

        <!-- Header -->
        <control type="group">
            <posx>64</posx>
            <posy>48</posy>
            <control type="label">
                <width>1200</width>
                <height>48</height>
                <font>Title</font>
                <textcolor>$VAR[Color_OnSurface]</textcolor>
                <label>Live Streams</label>
            </control>
            <control type="label">
                <posy>52</posy>
                <width>1200</width>
                <height>28</height>
                <font>CardBody</font>
                <textcolor>$VAR[Color_OnSurfaceVariant]</textcolor>
                <label>$INFO[Container.NumItems] channels live now</label>
            </control>
        </control>

        <!-- Stream grid -->
        <control type="panel" id="3000">
            <posx>48</posx>
            <posy>160</posy>
            <width>1824</width>
            <height>880</height>
            <onleft>9000</onleft>
            <onright>3000</onright>
            <onup>3000</onup>
            <ondown>3000</ondown>
            <orientation>horizontal</orientation>
            <itemlayout width="420" height="280">
                <!-- Resting-state card: flat, no elevation -->
                <control type="image">
                    <width>420</width>
                    <height>280</height>
                    <texture border="16">card_surface.png</texture>
                </control>
                <control type="image">
                    <posx>16</posx>
                    <posy>16</posy>
                    <width>388</width>
                    <height>218</height>
                    <aspectratio>scale</aspectratio>
                    <texture fallback="DefaultAddonNone.png">$INFO[ListItem.Thumb]</texture>
                </control>
                <control type="image">
                    <posx>32</posx>
                    <posy>32</posy>
                    <width>96</width>
                    <height>28</height>
                    <visible>!String.IsEmpty(ListItem.Property(is_live))</visible>
                    <texture>badge_live.png</texture>
                </control>
                <control type="label">
                    <posx>34</posx>
                    <posy>36</posy>
                    <width>90</width>
                    <height>28</height>
                    <font>CardLabel</font>
                    <textcolor>$VAR[Color_OnLiveBadge]</textcolor>
                    <align>center</align>
                    <visible>!String.IsEmpty(ListItem.Property(is_live))</visible>
                    <label>LIVE</label>
                </control>
                <control type="label">
                    <posx>16</posx>
                    <posy>244</posy>
                    <width>388</width>
                    <height>24</height>
                    <font>CardHeadline</font>
                    <textcolor>$VAR[Color_OnSurface]</textcolor>
                    <scroll>false</scroll>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <posx>16</posx>
                    <posy>264</posy>
                    <width>388</width>
                    <height>20</height>
                    <font>CardBody</font>
                    <textcolor>$VAR[Color_OnSurfaceVariant]</textcolor>
                    <label>$INFO[ListItem.Property(viewer_count)] viewers · $INFO[ListItem.Property(game_name)]</label>
                </control>
            </itemlayout>

            <focusedlayout width="420" height="280">
                <!-- Focused-state card: "elevated" texture (shadow baked
                     into the PNG) tinted yellow so the selected stream
                     is immediately visible. -->
                <control type="image">
                    <width>420</width>
                    <height>280</height>
                    <texture border="16">card_surface_focus.png</texture>
                    <colordiffuse>FFFFEB3B</colordiffuse>
                </control>
                <control type="image">
                    <posx>16</posx>
                    <posy>16</posy>
                    <width>388</width>
                    <height>218</height>
                    <aspectratio>scale</aspectratio>
                    <texture fallback="DefaultAddonNone.png">$INFO[ListItem.Thumb]</texture>
                </control>
                <control type="image">
                    <posx>32</posx>
                    <posy>32</posy>
                    <width>96</width>
                    <height>28</height>
                    <visible>!String.IsEmpty(ListItem.Property(is_live))</visible>
                    <texture>badge_live.png</texture>
                </control>
                <control type="label">
                    <posx>34</posx>
                    <posy>36</posy>
                    <width>90</width>
                    <height>28</height>
                    <font>CardLabel</font>
                    <textcolor>$VAR[Color_OnLiveBadge]</textcolor>
                    <align>center</align>
                    <visible>!String.IsEmpty(ListItem.Property(is_live))</visible>
                    <label>LIVE</label>
                </control>
                <control type="label">
                    <posx>16</posx>
                    <posy>244</posy>
                    <width>388</width>
                    <height>24</height>
                    <font>CardHeadline</font>
                    <textcolor>$VAR[Color_Primary]</textcolor>
                    <scroll>true</scroll>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <posx>16</posx>
                    <posy>264</posy>
                    <width>388</width>
                    <height>20</height>
                    <font>CardBody</font>
                    <textcolor>$VAR[Color_OnSurfaceVariant]</textcolor>
                    <label>$INFO[ListItem.Property(viewer_count)] viewers · $INFO[ListItem.Property(game_name)]</label>
                </control>
            </focusedlayout>
        </control>

    </controls>
</window>
